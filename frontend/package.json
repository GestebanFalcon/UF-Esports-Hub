{
  "name": "uf-esports-hub-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd ../shared build && bun --hot src/server.ts",
    "start": "bun run --cwd ../shared build && NODE_ENV=production bun src/server.ts",
    "build": "bun run --cwd ../shared build && bun run scripts/build.ts",
    "typecheck": "bun run --cwd ../shared build && tsc --noEmit",
    "test": "bun run --cwd ../shared build && bun test tests"
  },
  "dependencies": {
    "bun-plugin-tailwind": "^0.0.15",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4.1.11",
    "@uf-esports-hub/shared": "file:../shared"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  }
}
